APP_PASSWORD=replace-with-a-long-unique-password
PORT=3000
DATA_DIR=./data
# Only for local HTTP development; omit in production.
COOKIE_SECURE=false
# Built-in Kokoro is enabled by default. Set false only to use device voices alone.
TTS_ENABLED=true
# Optional speech tuning. Defaults work without these variables.
# TTS_THREADS=2
# TTS_CACHE_MB=256
